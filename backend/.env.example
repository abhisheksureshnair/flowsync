# Backend Environment Variables
# Copy this file to .env and fill in real values for local development.
# On Render, set these as environment variables in the Web Service settings.

# MongoDB Atlas connection string
MONGODB_URI=

# JWT secret for signing tokens (use a long, random string)
JWT_SECRET=

# Encryption key for storing AI API keys (use a long, random string)
ENCRYPTION_KEY=

# Deployed frontend URL for CORS (e.g. https://flowsync.onrender.com)
CLIENT_URL=

# Node environment (set to production on Render)
NODE_ENV=production
