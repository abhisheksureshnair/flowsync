# Frontend Environment Variables (Vite)
# Copy this file to .env and fill in real values for local development.
# On Render, set these as environment variables in the Static Site service.

# Base URL of your deployed backend API (e.g. https://flowsync-api.onrender.com/api)
VITE_API_URL=

# URL of your deployed backend for Socket.IO (e.g. https://flowsync-api.onrender.com)
VITE_SOCKET_URL=
